# Для развёртывания через docker-compose: скопируйте этот файл в .env (в этой же папке)
# и замените JWT_SECRET на длинную случайную строку — например, сгенерированную командой:
#   openssl rand -hex 32
# Никогда не используйте значение из примера в реальном развёртывании.
JWT_SECRET=replace-with-a-long-random-secret-before-deploying
